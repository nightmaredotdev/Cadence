// Cadence user interface.
//
// Logic lives in Rust (crates/app/src/gui.rs); this file only lays out the
// window and forwards user actions through callbacks.

import { Button, CheckBox, Palette, AboutSlint } from "std-widgets.slint";

// Lets the layout test render both colour schemes.
export { Palette }

export enum RunStatus { stopped, waiting, running, error }

export struct HotkeyRow {
    label: string,
    binding: string,
    problem: string,
    bound: bool,
}

// Shared colours and metrics. The metrics match Fluent's own controls
// (32 px tall, 4 px corners), so custom and standard controls line up.
global Theme {
    property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    // Status colours (Fluent's system colours, lighter on a dark background).
    out property <color> running: dark ? #6ccb5f : #0f7b0f;
    out property <color> waiting: dark ? #fce100 : #9d5d00;
    out property <color> error: dark ? #ff99a4 : #c42b1c;
    out property <color> idle: Palette.foreground.transparentize(55%);
    out property <color> muted: Palette.foreground.transparentize(35%);
    out property <color> divider: Palette.border.transparentize(30%);
    // Flat (subtle) controls: no fill until hovered or pressed.
    out property <color> subtle-hover: Palette.foreground.transparentize(92%);
    out property <color> subtle-pressed: Palette.foreground.transparentize(95%);
    out property <length> gap: 10px;
    out property <length> card-padding: 12px;
    out property <length> control-height: 32px;
    out property <length> control-radius: 4px;
    out property <length> card-radius: 8px;
    out property <length> title-size: 20px;
    out property <length> caption-size: 12px;
    out property <length> small-size: 11px;
}

component Card inherits Rectangle {
    in property <string> title;
    background: Palette.alternate-background;
    border-radius: Theme.card-radius;
    border-width: 1px;
    border-color: Palette.border.transparentize(40%);
    VerticalLayout {
        padding: Theme.card-padding;
        spacing: 8px;
        if root.title != "": VerticalLayout {
            spacing: 6px;
            Text {
                text: root.title;
                font-size: Theme.small-size;
                font-weight: 600;
                letter-spacing: 0.6px;
                color: Theme.muted;
            }
            // Subtle divider between the heading and the section's controls.
            Rectangle {
                height: 1px;
                background: Theme.divider;
            }
        }
        @children
    }
}

// Icons, drawn as 24 x 24 outlines (no image files).
global Icons {
    // Two stacked layers.
    out property <string> overlay: "M12 3 L3 7.5 L12 12 L21 7.5 Z M3 12 L12 16.5 L21 12 M3 16.5 L12 21 L21 16.5";
    // Arrows pointing inward / outward.
    out property <string> compact: "M4 14 L10 14 L10 20 M20 10 L14 10 L14 4 M14 10 L21 3 M3 21 L10 14";
    out property <string> expand: "M15 3 L21 3 L21 9 M9 21 L3 21 L3 15 M21 3 L14 10 M3 21 L10 14";
}

component Icon inherits Path {
    in property <color> tone;
    width: 16px;
    height: 16px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.tone;
    stroke-width: 1.6px;
    accessible-role: none;
}

// A key or key combination, drawn like a key cap.
component KeyCap inherits Rectangle {
    in property <string> key;
    in property <color> tone: Theme.muted;
    height: 18px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Palette.foreground.transparentize(78%);
    background: Palette.foreground.transparentize(95%);
    accessible-role: none;
    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        Text {
            text: root.key;
            font-size: Theme.small-size;
            color: root.tone;
            vertical-alignment: center;
        }
    }
}

// A flat button for secondary and tertiary actions: text in a muted colour,
// a subtle fill on hover. `destructive` turns it red on hover (Exit, Clear).
// Optionally an icon before the text and a key cap after it. One Tab stop;
// Space or Enter activates it. Like the standard buttons, a click does not
// take the keyboard focus.
component SubtleButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> shortcut;
    in property <bool> destructive;
    in property <bool> enabled: true;
    callback clicked;

    property <bool> hovered: area.has-hover && root.enabled;
    property <color> tone: !root.enabled ? Theme.idle
        : root.destructive && root.hovered ? Theme.error
        : root.hovered || focus.has-focus ? Palette.foreground : Theme.muted;

    min-height: Theme.control-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    background: area.pressed && root.enabled
        ? (root.destructive ? Theme.error.transparentize(90%) : Theme.subtle-pressed)
        : root.hovered ? (root.destructive ? Theme.error.transparentize(86%) : Theme.subtle-hover)
        : transparent;
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled { root.clicked(); }
    }

    focus := FocusScope {
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                return reject;
            }
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    area := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                commands: root.icon;
                tone: root.tone;
            }
        }
        Text {
            text: root.text;
            color: root.tone;
            vertical-alignment: center;
            animate color { duration: 120ms; }
        }
        if root.shortcut != "": VerticalLayout {
            alignment: center;
            KeyCap { key: root.shortcut; }
        }
    }
    // Keyboard focus ring, as on the tabs.
    if focus.has-focus: Rectangle {
        border-width: 2px;
        border-radius: root.border-radius;
        border-color: Palette.foreground;
    }
}

// The run state: a filled dot with a soft halo while clicking (or waiting,
// or after an error), a hollow ring while stopped.
component StatusDot inherits Rectangle {
    in property <RunStatus> status;
    property <bool> active: root.status != RunStatus.stopped;
    property <color> tone: root.status == RunStatus.running ? Theme.running
        : root.status == RunStatus.waiting ? Theme.waiting
        : root.status == RunStatus.error ? Theme.error : Theme.idle;
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background: root.active ? root.tone.transparentize(80%) : transparent;
    Rectangle {
        x: 5px;
        y: 5px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: root.active ? root.tone : transparent;
        border-width: root.active ? 0px : 2px;
        border-color: root.tone;
    }
}

// The status and the main action, shared by both layouts.
component StatusRow inherits HorizontalLayout {
    in property <RunStatus> status;
    in property <string> headline;
    in property <string> toggle-key;
    in property <length> headline-size: Theme.title-size;
    in property <length> button-width: 120px;
    callback start-stop();
    spacing: 12px;
    VerticalLayout {
        alignment: center;
        StatusDot { status: root.status; }
    }
    Text {
        text: root.headline;
        horizontal-stretch: 1;
        vertical-alignment: center;
        font-size: root.headline-size;
        font-weight: 700;
        overflow: elide;
        color: root.status == RunStatus.error ? Theme.error : Palette.foreground;
    }
    VerticalLayout {
        alignment: center;
        Button {
            text: (root.status == RunStatus.running || root.status == RunStatus.waiting ? "Stop" : "Start")
                + (root.toggle-key != "" ? " (" + root.toggle-key + ")" : "");
            primary: true;
            min-width: root.button-width;
            clicked => { root.start-stop(); }
        }
    }
}

component Message inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.error;
    in property <bool> dismissable: false;
    callback dismissed;
    background: root.tone.transparentize(88%);
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: root.tone.transparentize(60%);
    layout := HorizontalLayout {
        padding: 8px;
        padding-left: 10px;
        spacing: 8px;
        Text {
            text: root.text;
            wrap: word-wrap;
            color: Palette.foreground;
            font-size: Theme.caption-size;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        if root.dismissable: VerticalLayout {
            alignment: center;
            SubtleButton {
                text: "Dismiss";
                clicked => { root.dismissed(); }
            }
        }
    }
}

// A single-line numeric text field. Fluent's LineEdit always shows a clear
// ("X") button while focused, which is unnecessary here: selecting the value
// and typing replaces it. Editing, Enter and focus behave as in LineEdit.
component NumberField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <bool> enabled: true;
    out property <bool> has-focus: input.has-focus;
    callback edited();
    callback accepted();
    public function focus-input() {
        input.focus();
    }
    min-height: Theme.control-height;
    border-radius: Theme.control-radius;
    border-width: 1px;
    // A stronger border on hover, like the other controls' hover states.
    border-color: root.enabled && area.has-hover && !input.has-focus
        ? Palette.foreground.transparentize(70%) : Palette.border;
    background: root.enabled ? Palette.control-background : Palette.control-background.transparentize(60%);
    clip: true;
    animate border-color { duration: 120ms; }
    // Also takes clicks in the padding around the text, which focus it.
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
        input := TextInput {
            x: 8px;
            width: parent.width - 16px;
            height: parent.height;
            enabled: root.enabled;
            single-line: true;
            input-type: decimal;
            horizontal-alignment: right;
            vertical-alignment: center;
            color: root.enabled ? Palette.control-foreground : Theme.idle;
            selection-background-color: Palette.selection-background;
            selection-foreground-color: Palette.selection-foreground;
            edited => { root.edited(); }
            accepted => { root.accepted(); }
        }
    }
    // Focus indicator, like Fluent's text fields.
    if input.has-focus: Rectangle {
        x: 1px;
        y: parent.height - 2px;
        width: parent.width - 2px;
        height: 2px;
        background: Palette.accent-background;
    }
}

component FieldRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> description;
    in property <string> unit;
    in property <bool> enabled: true;
    /// The unit is a clickable toggle (e.g. ms / CPS).
    in property <bool> unit-toggles;
    in-out property <string> value;
    callback edited();
    callback commit();
    callback unit-clicked();
    public function focus-input() {
        edit.focus-input();
    }
    spacing: 10px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 1px;
        Text {
            text: root.label;
            color: root.enabled ? Palette.foreground : Theme.idle;
        }
        if root.description != "": Text {
            text: root.description;
            color: root.enabled ? Theme.muted : Theme.idle;
            font-size: Theme.small-size;
            wrap: word-wrap;
        }
    }
    HorizontalLayout {
        spacing: 6px;
        alignment: end;
        VerticalLayout {
            alignment: center;
            edit := NumberField {
                text <=> root.value;
                enabled: root.enabled;
                width: 80px;
                edited => { root.edited(); }
                accepted => { root.commit(); }
                // Also fires when focus moves elsewhere: another field, a tab,
                // or the window background (see `focus-sink` in MainWindow).
                changed has-focus => {
                    if !self.has-focus { root.commit(); }
                }
            }
        }
        if !root.unit-toggles: Text {
            text: root.unit;
            vertical-alignment: center;
            color: root.enabled ? Theme.muted : Theme.idle;
            width: 30px;
        }
        if root.unit-toggles: Rectangle {
            width: 30px;
            unit-area := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.unit-clicked(); }
            }
            Text {
                text: root.unit;
                vertical-alignment: center;
                horizontal-alignment: left;
                width: parent.width;
                height: parent.height;
                // Accent colour marks it as clickable; brighter on hover.
                color: unit-area.has-hover ? Palette.accent-background.brighter(20%) : Palette.accent-background;
            }
            // Thin underline, like a link.
            Rectangle {
                x: 0;
                y: parent.height / 2 + 8px;
                width: unit-text-width.preferred-width;
                height: 1px;
                background: unit-area.has-hover ? Palette.accent-background.brighter(20%) : Palette.accent-background.transparentize(40%);
            }
            unit-text-width := Text {
                visible: false;
                text: root.unit;
            }
        }
    }
}

// A two-option segmented control: both options always visible, the active one
// filled with the accent colour. Clicking an option selects it immediately.
//
// Keyboard: one Tab stop (like a radio group); Left/Right switch, Home/End
// go to the first or last option. A focus ring marks the active option while
// the control has keyboard focus. Mouse clicks do not focus it.
component SegmentedControl inherits FocusScope {
    in property <[string]> options;
    in property <int> selected;
    in property <string> label;
    callback select(int);
    focus-on-click: false;
    accessible-role: radio-group;
    accessible-label: root.label;
    key-pressed(event) => {
        if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
            return reject;
        }
        if event.text == Key.LeftArrow && root.selected > 0 {
            root.select(root.selected - 1);
            return accept;
        }
        if event.text == Key.RightArrow && root.selected < root.options.length - 1 {
            root.select(root.selected + 1);
            return accept;
        }
        if event.text == Key.LeftArrow || event.text == Key.RightArrow {
            return accept;
        }
        if event.text == Key.Home {
            root.select(0);
            return accept;
        }
        if event.text == Key.End {
            root.select(root.options.length - 1);
            return accept;
        }
        reject
    }
    Rectangle {
        border-radius: 6px;
        border-width: 1px;
        border-color: Palette.border;
        background: Palette.control-background;
        HorizontalLayout {
            padding: 2px;
            spacing: 2px;
            for option[index] in root.options: Rectangle {
                horizontal-stretch: 1;
                min-height: 28px;
                border-radius: 4px;
                accessible-role: radio-button;
                accessible-label: option;
                accessible-checkable: true;
                accessible-checked: root.selected == index;
                accessible-action-default => { root.select(index); }
                background: root.selected == index ? Palette.accent-background
                    : segment-area.has-hover ? Theme.subtle-hover : transparent;
                animate background { duration: 120ms; }
                // Keyboard focus ring on the active option.
                border-width: root.has-focus && root.selected == index ? 2px : 0px;
                border-color: Palette.foreground;
                segment-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.select(index); }
                }
                Text {
                    text: option;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-weight: root.selected == index ? 600 : 400;
                    color: root.selected == index ? Palette.accent-foreground
                        : segment-area.has-hover ? Palette.foreground : Theme.muted;
                }
            }
        }
    }
}

// Shown in overlay mode where the view buttons were: the window ignores the
// mouse then, so it names the hotkey that switches overlay mode off. An
// accent badge, matching the accent frame around the window.
component OverlayHint inherits Rectangle {
    in property <string> key;
    height: 26px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 13px;
    background: Palette.accent-background.transparentize(84%);
    border-width: 1px;
    border-color: Palette.accent-background.transparentize(50%);
    accessible-role: text;
    accessible-label: "Overlay on. Press " + root.key + " to interact.";
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Icon {
                commands: Icons.overlay;
                tone: Palette.accent-background;
                width: 14px;
                height: 14px;
            }
        }
        Text {
            text: "Overlay on";
            font-size: Theme.caption-size;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            text: "·";
            font-size: Theme.caption-size;
            color: Theme.muted;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            KeyCap {
                key: root.key;
                tone: Palette.foreground;
            }
        }
        Text {
            text: "to interact";
            font-size: Theme.caption-size;
            color: Theme.muted;
            vertical-alignment: center;
        }
    }
}

// The window-level actions, below the status in both layouts (so the layout
// toggle stays in the same place): overlay mode on the left, the other
// layout on the right. In overlay mode the window ignores the mouse, so the
// badge naming the hotkey that ends it takes their place, at the same
// height (the window never changes size for it).
component WindowActions inherits HorizontalLayout {
    in property <bool> compact;
    in property <bool> overlay-active;
    in property <string> overlay-key;
    in property <length> vertical-padding;
    in property <length> horizontal-padding;
    callback overlay-clicked();
    callback layout-clicked();
    spacing: 4px;
    padding-top: root.vertical-padding;
    padding-bottom: root.vertical-padding;
    padding-left: root.horizontal-padding;
    padding-right: root.horizontal-padding;
    // A layout's min-height includes its padding.
    min-height: Theme.control-height + 2 * root.vertical-padding;
    if !root.overlay-active: SubtleButton {
        text: "Overlay";
        icon: Icons.overlay;
        shortcut: root.overlay-key;
        clicked => { root.overlay-clicked(); }
    }
    if !root.overlay-active: Rectangle { horizontal-stretch: 1; }
    if !root.overlay-active: SubtleButton {
        text: root.compact ? "Full view" : "Compact";
        icon: root.compact ? Icons.expand : Icons.compact;
        clicked => { root.layout-clicked(); }
    }
    if root.overlay-active: HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            OverlayHint { key: root.overlay-key; }
        }
    }
}

// The status, the main action and the window actions, in one card at the
// top of both layouts: the same component, metrics and size in both (only
// its width follows the window's). Nothing in it depends on the layout but
// the label of the layout button; an error grows it in the full layout only
// (the compact layout shows it in the line below the card instead).
component StatusPanel inherits Rectangle {
    in property <RunStatus> status;
    in property <string> headline;
    in property <string> toggle-key;
    in property <bool> compact;
    in property <bool> overlay-active;
    in property <string> overlay-key;
    /// An error, shown as a message under the status (full layout).
    in property <string> error;
    callback start-stop();
    callback overlay-clicked();
    callback layout-clicked();
    background: Palette.alternate-background;
    border-radius: Theme.card-radius;
    border-width: 1px;
    border-color: Palette.border.transparentize(40%);
    VerticalLayout {
        padding: 1px;
        VerticalLayout {
            padding: 10px;
            padding-left: Theme.card-padding - 1px;
            padding-right: Theme.card-padding - 1px;
            spacing: 8px;
            StatusRow {
                status: root.status;
                headline: root.headline;
                toggle-key: root.toggle-key;
                start-stop => { root.start-stop(); }
            }
            if root.error != "": Message { text: root.error; }
        }
        Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        WindowActions {
            vertical-padding: 2px;
            horizontal-padding: 5px;
            compact: root.compact;
            overlay-active: root.overlay-active;
            overlay-key: root.overlay-key;
            overlay-clicked => { root.overlay-clicked(); }
            layout-clicked => { root.layout-clicked(); }
        }
    }
}

export component AboutWindow inherits Window {
    in property <string> version;
    callback close-clicked();
    /// The size the window opens at (read by Rust to place it beside the
    /// main window before it is shown).
    out property <length> layout-preferred-width: 380px;
    out property <length> layout-preferred-height: about-layout.preferred-height;
    title: "About Cadence";
    icon: @image-url("../../../assets/icon/icon-256.png");
    min-width: 380px;
    preferred-width: root.layout-preferred-width;
    background: Palette.background;
    about-layout := VerticalLayout {
        padding: 20px;
        spacing: 12px;
        alignment: start;
        HorizontalLayout {
            spacing: 12px;
            Image {
                source: @image-url("../../../assets/icon/icon-256.png");
                width: 40px;
                height: 40px;
                accessible-role: none;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: "Cadence";
                    font-size: Theme.title-size;
                    font-weight: 700;
                }
                Text {
                    text: "Version " + root.version;
                    font-size: Theme.caption-size;
                    color: Theme.muted;
                }
            }
        }
        Text {
            text: "A desktop autoclicker with precise, configurable click timing, human-like variation, clicking at a fixed position or at the cursor, and global hotkeys.";
            wrap: word-wrap;
        }
        Text {
            text: "Licensed under the MIT License.";
            color: Theme.muted;
            font-size: Theme.caption-size;
        }
        AboutSlint {
            min-height: 150px;
            max-height: 190px;
        }
        HorizontalLayout {
            alignment: end;
            // A flat secondary action, like Logs, About and Exit.
            SubtleButton {
                text: "Close";
                clicked => { root.close-clicked(); }
            }
        }
    }
}

export component MainWindow inherits Window {
    // ---- state from Rust ----
    in property <string> window-title: "Cadence";
    in property <RunStatus> status: RunStatus.stopped;
    in property <string> status-headline: "Stopped";
    in property <string> error-text;
    in property <string> notice-text;
    in property <string> config-warning;
    /// The toggle hotkey ("" if unbound), shown on the Start/Stop button.
    in property <string> toggle-key;
    in-out property <bool> fixed-mode: true;
    in property <string> target-text: "Not set";
    /// A position is being picked (the next click on screen sets it).
    in property <bool> picking;
    in-out property <string> interval-text;
    in-out property <string> jitter-text;
    in-out property <string> hold-text;
    in-out property <string> radius-text;
    in property <bool> interval-in-cps;
    in property <string> settings-error;
    in property <bool> settings-pending;
    in property <[HotkeyRow]> hotkeys;
    in-out property <int> current-tab: 0;
    /// Whether the tab bar has keyboard focus (read by the GUI tests).
    out property <bool> tab-bar-focused;
    in-out property <int> capturing-index: -1;
    in property <string> hotkeys-error;
    in-out property <bool> keep-on-top;
    /// The compact layout: status, Start/Stop and the view buttons only.
    in property <bool> compact-mode;
    /// Overlay mode: the window is translucent and lets clicks pass through.
    in property <bool> overlay-active;
    /// The overlay hotkey ("" if unbound), shown on the Overlay button.
    in property <string> overlay-key;
    /// Where and how often Cadence clicks, shown by the compact layout.
    in property <string> summary-text;

    // ---- user actions ----
    callback start-stop-clicked();
    callback mode-selected(bool);
    callback pick-target-clicked();
    callback settings-edited();
    callback settings-commit();
    callback interval-unit-clicked();
    callback hotkey-record(int);
    callback hotkey-key(string, bool, bool, bool);
    callback hotkey-cancel();
    callback hotkey-clear(int);
    callback keep-on-top-toggled(bool);
    callback about-clicked();
    callback open-logs-clicked();
    callback exit-clicked();
    callback warning-dismissed();
    callback compact-toggled();
    callback overlay-clicked();
    // ---- wake-ups from worker threads (invoked via the event loop) ----
    callback status-ready();
    callback exit-requested();
    callback show-requested();
    callback pick-decided();
    callback overlay-hotkey();
    // ---- window events ----
    callback width-changed();
    changed width => { root.width-changed(); }

    /// Whether the mode control has keyboard focus (read by the GUI tests).
    out property <bool> mode-control-focused;
    /// The coordinate display next to Pick target.
    out property <string> coordinates-text: "Coordinates: " + root.target-text;
    /// "Pick target" is only available in Fixed position mode.
    out property <bool> pick-enabled: root.fixed-mode;
    /// The size of the current layout, which the window takes when the
    /// layout changes (read by Rust).
    out property <length> layout-preferred-width: root.compact-mode ? 360px : 420px;
    out property <length> layout-preferred-height: main-layout.preferred-height;
    /// The status panel's bounds in the window (checked by the layout test).
    out property <length> status-panel-x: status-panel.absolute-position.x;
    out property <length> status-panel-y: status-panel.absolute-position.y;
    out property <length> status-panel-width: status-panel.width;
    out property <length> status-panel-height: status-panel.height;

    // The Interval field only exists in the full layout, so it is focused
    // through this counter rather than by its id.
    property <int> focus-interval-request;

    /// Puts keyboard focus into the Interval field (used by the GUI tests).
    public function focus-interval-field() {
        root.focus-interval-request += 1;
    }

    /// Moves keyboard focus off any edited field (which commits it).
    public function release-field-focus() {
        focus-sink.focus();
    }

    public function start-recording(index: int) {
        root.capturing-index = index;
        key-capture.focus();
        root.hotkey-record(index);
    }

    title: root.window-title;
    icon: @image-url("../../../assets/icon/icon-256.png");
    // Overlay mode keeps the window in front: the program clicked through it
    // is activated and would otherwise cover it.
    always-on-top: root.keep-on-top || root.overlay-active;
    min-width: root.compact-mode ? 320px : 400px;
    preferred-width: root.layout-preferred-width;
    // The compact layout is exactly as tall as its content.
    max-height: root.compact-mode ? main-layout.preferred-height : main-layout.max-height;
    background: Palette.background;

    // Behind all content: clicking any non-interactive area (card backgrounds,
    // labels, padding) gives the focus to this scope, so a timing field being
    // edited loses focus and commits through its `changed has-focus` handler.
    // Buttons do not take focus when clicked; their actions commit pending
    // edits in Rust before running.
    focus-sink := FocusScope {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        focus-on-tab-navigation: false;
    }

    // Captures the next key while a hotkey is being recorded.
    key-capture := FocusScope {
        x: 0; y: 0; width: 0; height: 0;
        enabled: root.capturing-index >= 0;
        key-pressed(event) => {
            if root.capturing-index < 0 { return reject; }
            if event.repeat { return accept; }
            root.hotkey-key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
            accept
        }
        changed has-focus => {
            if !self.has-focus && root.capturing-index >= 0 {
                root.hotkey-cancel();
            }
        }
    }

    // The full layout (status, tabs, settings, footer) or the compact one
    // (status and the view buttons). Both use the same status row; each
    // layout's parts are created only while it is shown, so neither has
    // hidden controls (or hidden keyboard stops).
    main-layout := VerticalLayout {
        padding: 14px;
        // The compact layout's last line has 2-3 px of space inside it.
        padding-bottom: root.compact-mode ? 10px : 14px;
        spacing: Theme.gap;

        if root.config-warning != "": Message {
            text: root.config-warning;
            tone: Theme.waiting;
            dismissable: true;
            dismissed => { root.warning-dismissed(); }
        }

        // ---- status, main action and window actions ----
        // The same panel, 91 px tall, in both layouts. The full layout shows
        // an error as a message in it, and notices below it; the compact
        // layout a line below it instead (see there).
        status-panel := StatusPanel {
            status: root.status;
            headline: root.status-headline;
            toggle-key: root.toggle-key;
            compact: root.compact-mode;
            overlay-active: root.overlay-active;
            overlay-key: root.overlay-key;
            error: root.compact-mode ? "" : root.error-text;
            start-stop => { root.start-stop-clicked(); }
            overlay-clicked => {
                root.release-field-focus();
                root.overlay-clicked();
            }
            layout-clicked => {
                root.release-field-focus();
                root.compact-toggled();
            }
        }

        // Compact layout: a line below the panel saying where and how often
        // Cadence clicks, with an error or a notice (e.g. Start without a
        // position) in its place, so the window never changes size:
        // 14 + 91 + 10 + 17 + 10 = exactly the 142 px of the compact window.
        if root.compact-mode: Text {
            height: 17px;
            text: root.error-text != "" ? root.error-text
                : root.notice-text != "" ? root.notice-text : root.summary-text;
            color: root.error-text != "" ? Theme.error
                : root.notice-text != "" ? Palette.foreground : Theme.muted;
            font-size: Theme.caption-size;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
        }

        // Problem notices (e.g. Start without a position), below the status
        // card. The line only exists while there is a notice; no space is
        // reserved for it otherwise.
        if !root.compact-mode && root.notice-text != "": Text {
            text: root.notice-text;
            color: Theme.muted;
            font-size: Theme.caption-size;
            overflow: elide;
            horizontal-alignment: center;
        }

        // Tab bar with centred labels (the standard TabWidget left-aligns
        // them). Clicking a tab moves the focus off an edited field first, so
        // the field commits as before.
        //
        // Keyboard: the bar is a single Tab stop (like a standard tab list);
        // Left/Right switch between the two tabs, Home/End go to the first or
        // last one. A focus ring marks the active tab while the bar has
        // keyboard focus. Reaching the bar with Tab moves the focus off an
        // edited field, which commits it. Mouse clicks do not focus the bar.
        if !root.compact-mode: tab-bar := FocusScope {
            focus-on-click: false;
            accessible-role: tab-list;
            accessible-item-count: 2;
            changed has-focus => { root.tab-bar-focused = self.has-focus; }
            key-pressed(event) => {
                if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                    return reject;
                }
                if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                    root.current-tab = root.current-tab == 0 ? 1 : 0;
                    return accept;
                }
                if event.text == Key.Home {
                    root.current-tab = 0;
                    return accept;
                }
                if event.text == Key.End {
                    root.current-tab = 1;
                    return accept;
                }
                reject
            }
            VerticalLayout {
                spacing: 0px;
                HorizontalLayout {
                    for title[index] in ["Settings", "Hotkeys"]: Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        border-radius: Theme.control-radius;
                        accessible-role: tab;
                        accessible-label: title;
                        accessible-item-index: index;
                        accessible-item-selectable: true;
                        accessible-item-selected: root.current-tab == index;
                        // Keyboard focus ring on the active tab.
                        border-width: tab-bar.has-focus && root.current-tab == index ? 2px : 0px;
                        border-color: Palette.foreground;
                        tab-area := TouchArea {
                            clicked => {
                                root.release-field-focus();
                                root.current-tab = index;
                            }
                        }
                        Text {
                            text: title;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-weight: root.current-tab == index ? 600 : 400;
                            // Hover only brightens the label; the active tab
                            // stays marked by weight and the accent underline.
                            color: root.current-tab == index || tab-area.has-hover
                                ? Palette.foreground : Theme.muted;
                            animate color { duration: 120ms; }
                        }
                        if root.current-tab == index: Rectangle {
                            y: parent.height - 3px;
                            x: (parent.width - 32px) / 2;
                            width: 32px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: Palette.accent-background;
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.divider;
                }
            }
        }

        // Both pages occupy the same area, which is as tall as the larger
        // one, so the window size does not change between tabs. The hidden
        // page is invisible and takes no input.
        if !root.compact-mode: Rectangle {
            vertical-stretch: 1;
            min-height: max(settings-page.preferred-height, hotkeys-page.preferred-height);
            min-width: max(settings-page.min-width, hotkeys-page.min-width);
            settings-page := VerticalLayout {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                visible: root.current-tab == 0;
                    spacing: Theme.gap;
                    alignment: start;
                    Card {
                        title: "TARGET";
                        mode-control := SegmentedControl {
                            label: "Click position";
                            options: ["Fixed position", "Current position"];
                            selected: root.fixed-mode ? 0 : 1;
                            changed has-focus => { root.mode-control-focused = self.has-focus; }
                            select(index) => {
                                // A click (not a key press) moves the focus off an
                                // edited field, which commits it.
                                if !self.has-focus { root.release-field-focus(); }
                                root.mode-selected(index == 0);
                            }
                        }
                        // The saved position stays visible (and is kept) in both
                        // modes; it is only used, and can only be picked, in
                        // Fixed position mode.
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: root.coordinates-text;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                                color: root.fixed-mode ? Palette.foreground : Theme.idle;
                            }
                            Button {
                                text: root.picking ? "Cancel" : "Pick target";
                                enabled: root.pick-enabled;
                                min-width: 96px;
                                clicked => { root.pick-target-clicked(); }
                            }
                        }
                        Text {
                            text: root.picking
                                ? "Click to set the position. Right-click to cancel."
                                : root.fixed-mode
                                    ? "Clicks at the saved position. Use Pick target to change it."
                                    : "Clicks wherever the cursor is. The cursor is never moved.";
                            font-weight: root.picking ? 600 : 400;
                            color: root.picking ? Palette.foreground : Theme.muted;
                            font-size: Theme.caption-size;
                            wrap: word-wrap;
                        }
                    }
                    Card {
                        title: "TIMING";
                        interval-row := FieldRow {
                            property <int> focus-request: root.focus-interval-request;
                            changed focus-request => { self.focus-input(); }
                            label: "Interval";
                            description: "Time between consecutive click starts.";
                            unit: root.interval-in-cps ? "CPS" : "ms";
                            unit-toggles: true;
                            unit-clicked => { root.interval-unit-clicked(); }
                            value <=> root.interval-text;
                            edited => { root.settings-edited(); }
                            commit => { root.settings-commit(); }
                        }
                        FieldRow {
                            label: "Interval jitter (σ)";
                            description: "Adds random variation to the interval between clicks.";
                            unit: "ms";
                            value <=> root.jitter-text;
                            edited => { root.settings-edited(); }
                            commit => { root.settings-commit(); }
                        }
                        FieldRow {
                            label: "Hold duration";
                            description: "How long the mouse button stays pressed for each click.";
                            unit: "ms";
                            value <=> root.hold-text;
                            edited => { root.settings-edited(); }
                            commit => { root.settings-commit(); }
                        }
                        FieldRow {
                            label: "Position jitter";
                            description: "Randomly offsets the click position within the configured radius. Fixed position mode only.";
                            unit: "px";
                            enabled: root.fixed-mode;
                            value <=> root.radius-text;
                            edited => { root.settings-edited(); }
                            commit => { root.settings-commit(); }
                        }
                        if root.settings-error != "": Message { text: root.settings-error; }
                        if root.settings-pending && root.settings-error == "": Text {
                            text: "Press Enter or leave the field to apply.";
                            color: Theme.muted;
                            font-size: Theme.small-size;
                        }
                    }
                }
            hotkeys-page := VerticalLayout {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                visible: root.current-tab == 1;
                spacing: Theme.gap;
                alignment: start;
                // All bindings in one card, separated by subtle dividers.
                Card {
                    for row[index] in root.hotkeys: VerticalLayout {
                        spacing: 8px;
                        if index > 0: Rectangle {
                            height: 1px;
                            background: Theme.divider;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text { text: row.label; }
                                if row.problem != "": Text {
                                    text: row.problem;
                                    color: Theme.error;
                                    font-size: Theme.small-size;
                                    wrap: word-wrap;
                                }
                            }
                            Button {
                                text: root.capturing-index == index ? "Press keys…" : row.binding;
                                primary: root.capturing-index == index;
                                min-width: 132px;
                                clicked => {
                                    if root.capturing-index == index {
                                        root.hotkey-cancel();
                                    } else {
                                        root.start-recording(index);
                                    }
                                }
                            }
                            SubtleButton {
                                text: "Clear";
                                destructive: true;
                                enabled: row.bound && root.capturing-index < 0;
                                clicked => { root.hotkey-clear(index); }
                            }
                        }
                    }
                }
                if root.hotkeys-error != "": Message { text: root.hotkeys-error; }
                if root.capturing-index >= 0: Text {
                    text: "Press the new key combination, or Esc to cancel. If nothing happens, another program already uses that combination.";
                    color: Theme.muted;
                    font-size: Theme.small-size;
                    wrap: word-wrap;
                }
            }
        }

        if !root.compact-mode: HorizontalLayout {
            spacing: 8px;
            CheckBox {
                text: "Always on top";
                checked <=> root.keep-on-top;
                toggled => { root.keep-on-top-toggled(self.checked); }
            }
            Rectangle { horizontal-stretch: 1; }
            // Tertiary actions: flat, so the primary Start/Stop stays the
            // strongest control. Exit turns red on hover.
            SubtleButton {
                text: "Logs";
                clicked => { root.open-logs-clicked(); }
            }
            SubtleButton {
                text: "About";
                clicked => { root.about-clicked(); }
            }
            SubtleButton {
                text: "Exit";
                destructive: true;
                clicked => { root.exit-clicked(); }
            }
        }
    }

    // Overlay mode: an accent frame marks the edges of the translucent
    // window. Creating and removing it also repaints the whole window, which
    // the switch to and from a layered window needs.
    if root.overlay-active: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        border-width: 2px;
        border-color: Palette.accent-background;
    }
}

// Notification-area icon. Closing the main window hides it; the tray keeps
// the application reachable and offers an explicit Exit.
export component AppTray inherits SystemTrayIcon {
    in property <bool> running;
    in property <bool> window-visible: true;
    in property <bool> overlay-active;
    callback show-window();
    callback toggle-window();
    callback start-stop();
    callback toggle-overlay();
    callback open-logs();
    callback exit();

    icon: root.running ? @image-url("../../../assets/icon/tray-running.png") : @image-url("../../../assets/icon/tray-idle.png");
    tooltip: root.running ? "Cadence - running" : "Cadence - stopped";
    title: "Cadence";
    clicked => { root.show-window(); }

    Menu {
        MenuItem {
            title: root.window-visible ? "Hide window" : "Show window";
            activated => { root.toggle-window(); }
        }
        MenuItem {
            title: root.running ? "Stop clicking" : "Start clicking";
            activated => { root.start-stop(); }
        }
        // Also the way back when the window ignores the mouse.
        MenuItem {
            title: root.overlay-active ? "Turn off overlay" : "Turn on overlay";
            activated => { root.toggle-overlay(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Open log folder";
            activated => { root.open-logs(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Exit";
            activated => { root.exit(); }
        }
    }
}
